# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/.vercel
*.tsbuildinfo

# environment & secrets (NEVER commit secrets or certificates)
.env*
*.pem
*.key
*.cert

# misc & OS files
.DS_Store
._*
__MACOSX/
Thumbs.db

# archives & backups
*.zip
*.tar
*.tar.gz
*.rar
*.7z
/backups/
/myback/
/_KWD_CLEANUP_VAULT/
/*_archive*/

# local agent / IDE state
.idea/
.vscode/
.Jules/
.kiro/
.claude/
skills-lock.json

# temporary files and scripts
*.log
__*.log
_*.mjs
_*.js
test-*.js
test-*.mjs
*.pyc
__pycache__/
*.tmp
*.bak
scratch/

# documentation archives (backups and exports)
/docs/archive/
/docs/business-plans/*.docx
/docs/business-plans/*.txt

# auto-organized content (legacy)
/docs/auto-organized/
/docs/archive/auto-backups/
/docs/archive/temp/

# Local scripts, data, and videoads marketing tool (never commit or push)
/scripts/
/data/
/src/app/videoads/

# Student login credentials — plaintext passwords, never commit
/scripts/generated_credentials.txt
/scripts/archive/generated_credentials.txt
/Grade5_Student_Credentials_JVNUPL.html
/Grade5_Student_Credentials_JVNUPL.xlsx
/Grade5_Student_Logins_KH.html

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
